{
  "ReverseProxy": {
    "Routes": {
      "catalog-read-route": {
        "ClusterId": "catalog-read-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "catalog-write-route": {
        "ClusterId": "catalog-write-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE", "PATCH" ]
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "shipping-route": {
        "ClusterId": "shipping-cluster",
        "Match": {
          "Path": "/api/shipping/{**catch-all}"
        }
      },
      "order-read-route": {
        "ClusterId": "order-read-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "order-write-route": {
