          "Path": "/api/invoices/{**catch-all}"
        }
      },
      "expedition-route": {
        "ClusterId": "expedition-cluster",
        "Match": {
          "Path": "/api/expeditions/{**catch-all}"
        }
      }
    },
    "Clusters": {
