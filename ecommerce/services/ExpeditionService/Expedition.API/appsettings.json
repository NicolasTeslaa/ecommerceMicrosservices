{
  "ConnectionStrings": {
    "ExpeditionDb": "server=localhost;port=3306;database=ecommerce-platform-expedition;user=root;password=12345678"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "InvoiceIssuedTopic": "invoice.issued",
    "ExpeditionAwaitingCarrierPickupTopic": "expedition.awaiting-carrier-pickup",
    "ExpeditionPickedUpByCarrierTopic": "expedition.picked-up-by-carrier",
    "ExpeditionInTransitTopic": "expedition.in-transit",
    "ExpeditionDeliveredTopic": "expedition.delivered",
    "ExpeditionDeliveryFailedTopic": "expedition.delivery-failed"
  },
  "ExpeditionAutomation": {
    "Enabled": true,
    "StepIntervalSeconds": 60,
    "FailureChance": 0.2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
